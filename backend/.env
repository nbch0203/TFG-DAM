# Variables de entorno para conexión a base de datos MySQL en AWS (RDS)
# Valores proporcionados por el usuario (RDS)
DB_HOST=schoolsafetrack-bbdd.cb4e4c620pjb.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=tfg_user
DB_PASSWORD=tfg_password
DB_NAME=schoolsafetrack

# Firebase Cloud Messaging
# Define FIREBASE_SERVICE_ACCOUNT_PATH o FIREBASE_SERVICE_ACCOUNT_JSON antes de ejecutar pruebas
FIREBASE_PROJECT_ID=schoolsafetrack
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Alternativa: pegar el JSON completo en una sola línea
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
