# Variables de entorno para conexión a base de datos MySQL en AWS
DB_HOST=tu-endpoint-mysql-aws
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=contraseña
DB_NAME=schoolsafetrack

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=/ruta/al/service-account.json
# Alternativa: pegar el JSON completo en una sola línea
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
